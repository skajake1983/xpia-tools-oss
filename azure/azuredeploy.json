{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "xpia-tools",
      "metadata": { "description": "Name of the Azure Web App" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for deployment" }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": ["F1", "B1", "B2", "S1", "S2", "P1v3"],
      "metadata": { "description": "App Service Plan SKU" }
    },
    "jwtSecret": {
      "type": "securestring",
      "metadata": { "description": "JWT signing secret (min 64 characters)" }
    }
  },
  "variables": {
    "appServicePlanName": "[concat(parameters('appName'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "NODE|20-lts",
          "appSettings": [
            { "name": "NODE_ENV", "value": "production" },
            { "name": "PORT", "value": "8080" },
            { "name": "JWT_SECRET", "value": "[parameters('jwtSecret')]" },
            { "name": "JWT_EXPIRES_IN", "value": "24h" },
            { "name": "CLIENT_URL", "value": "[concat('https://', parameters('appName'), '.azurewebsites.net')]" },
            { "name": "WEBSITE_NODE_DEFAULT_VERSION", "value": "~20" },
            { "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "false" }
          ],
          "alwaysOn": "[not(equals(parameters('sku'), 'F1'))]",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "http20Enabled": true
        },
        "httpsOnly": true
      }
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('appName'), '.azurewebsites.net')]"
    }
  }
}
