{
  "name": "xpia-tools-server",
  "version": "1.5.2",
  "private": true,
  "license": "MIT",
  "author": "Jacob Adams",
  "repository": {
    "type": "git",
    "url": "https://github.com/skajake1983/xpia-tools-oss.git",
    "directory": "server"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const{cpSync}=require('fs');cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.9.1",
    "@azure/storage-blob": "^12.31.0",
    "applicationinsights": "^3.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
