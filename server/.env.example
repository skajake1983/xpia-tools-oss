# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-64-chars
JWT_EXPIRES_IN=24h

# Encryption (64-char hex string — 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# CORS
CLIENT_URL=http://localhost:5173

# Azure (for production)
AZURE_STORAGE_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure Communication Services Email
# Connection string from your Communication Services resource in Azure Portal
AZURE_COMMUNICATION_CONNECTION_STRING=
# Sender address (from verified domain, or *.azurecomm.net for testing)
EMAIL_SENDER_ADDRESS=

# GitHub (for in-app feedback → GitHub Issues)
# Personal access token with 'repo' scope
GITHUB_TOKEN=
# Repository in owner/repo format
GITHUB_REPO=owner/repo-name

# Azure CosmosDB (defaults below target the local emulator)
# For production, set these to your Azure CosmosDB account values
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=xpia-tools
